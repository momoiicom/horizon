{%- comment -%}
  CÓCOES Footer/CTA Benefits Section
  
  Dark footer with CTA button linking to next page.
{%- endcomment -%}

{% capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'section', section: section, children: children %}

{% schema %}
{
  "name": "CÓCOES Footer - Benefits",
  "tag": "section",
  "class": "section-wrapper cocoes-footer-benefits",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "Direction",
      "options": [
        {
          "value": "column",
          "label": "Vertical"
        },
        {
          "value": "row",
          "label": "Horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "CÓCOES Footer - Benefits",
      "category": "CÓCOES",
      "blocks": {
        "content_group": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "horizontal_alignment_flex_direction_column": "center",
            "gap": 32,
            "width": "custom",
            "custom_width": 70,
            "width_mobile": "fill"
          },
          "blocks": {
            "heading": {
              "type": "text",
              "settings": {
                "text": "<h2>Ready to Start Cooking?</h2>",
                "type_preset": "h2",
                "width": "100%",
                "alignment": "center"
              }
            },
            "subtext": {
              "type": "text",
              "settings": {
                "text": "<p>You don't have to choose between what's good for you and what tastes good. With CÓCOES, you get both.</p>",
                "type_preset": "rte",
                "width": "100%",
                "alignment": "center"
              }
            }
          },
          "block_order": ["heading", "subtext"]
        },
        "cta_group": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "horizontal_alignment_flex_direction_column": "center",
            "gap": 24,
            "width": "fill"
          },
          "blocks": {
            "next_label": {
              "type": "text",
              "settings": {
                "text": "<p>NEXT UP</p>",
                "type_preset": "h6",
                "alignment": "center"
              }
            },
            "cta_button": {
              "type": "button",
              "settings": {
                "label": "Flavor Profiles & How to Use →",
                "link": "shopify://pages/flavor-and-how-to-use",
                "style_class": "button"
              }
            }
          },
          "block_order": ["next_label", "cta_button"]
        }
      },
      "block_order": ["content_group", "cta_group"],
      "settings": {
        "horizontal_alignment_flex_direction_column": "center",
        "gap": 48,
        "color_scheme": "scheme-1",
        "padding-block-start": 96,
        "padding-block-end": 96
      }
    }
  ]
}
{% endschema %}
